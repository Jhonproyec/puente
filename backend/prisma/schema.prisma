// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario      Int      @id @default(autoincrement())
  email           String   @unique
  password        String
  nombres         String
  apellidos       String
  id_rol          Int
  estado_registro Boolean  @default(true)
  fecha_creacion  DateTime @default(now())
  fecha_edicion   DateTime @updatedAt
  accesso_global  Boolean  @default(false)
  dpi             String?  @db.VarChar(13)
  rol             Rol      @relation(fields: [id_rol], references: [id_rol])
  qr_path         String?  @db.VarChar(500)

  formulariosAsignados   FormularioUsuario[]
  formulariosCreados     Formulario[]          @relation("FormularioCreador")
  formulariosModificados Formulario[]          @relation("FormularioModificador")
  respuestas             FormularioRespuesta[]
  comunidades            UsuarioComunidad[]
  hitosEncuestas         HitosEncuesta[]
  centroNutreme         CentroNutreme[]


  @@index([estado_registro])
  @@index([id_rol])
  @@index([fecha_creacion])
  @@index([estado_registro, fecha_creacion])
  @@index([email, estado_registro])
  @@index([dpi])
}

model UsuarioComunidad {
  id_usuario   Int
  id_comunidad Int
  usuario      Usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  comunidad    Comunidad @relation(fields: [id_comunidad], references: [id_comunidad], onDelete: Cascade)

  @@id([id_usuario, id_comunidad])
  @@index([id_comunidad])
}

//************ROLES Y PERMISOS
enum Accion {
  VIEW
  CREATE
  UPDATE
  DELETE
}

model Modulo {
  id_modulo       Int      @id @default(autoincrement())
  nombre          String   @db.VarChar(255)
  estado_registro Boolean  @default(true)
  fecha_registro  DateTime @default(now())
  fecha_edicion   DateTime @updatedAt

  permisos Permiso[]
}

model Permiso {
  id_permiso      Int      @id @default(autoincrement())
  accion          Accion
  codigo          String   @unique @db.VarChar(150)
  id_modulo       Int
  descripcion     String   @db.VarChar(255)
  estado_registro Boolean  @default(true)
  fecha_registro  DateTime @default(now())
  fecha_edicion   DateTime @updatedAt

  modulo Modulo       @relation(fields: [id_modulo], references: [id_modulo], onDelete: Cascade)
  roles  RolPermiso[]

  @@index([codigo, estado_registro])
  @@index([estado_registro])
}

model Rol {
  id_rol          Int      @id @default(autoincrement())
  nombre          String   @db.VarChar(150)
  estado_registro Boolean  @default(true)
  fecha_registro  DateTime @default(now())
  fecha_edicion   DateTime @updatedAt

  permisos RolPermiso[]
  usuarios Usuario[]

  @@index([estado_registro])
}

model RolPermiso {
  id_rol     Int
  id_permiso Int

  rol     Rol     @relation(fields: [id_rol], references: [id_rol], onDelete: Cascade)
  permiso Permiso @relation(fields: [id_permiso], references: [id_permiso], onDelete: Cascade)

  @@id([id_rol, id_permiso])
}

//************FIN ROLES Y PERMISOS

// **************CATALOGOS
model Catalog {
  id_catalogo     Int      @id @default(autoincrement())
  nombre          String   @db.VarChar(150)
  tiene_cascada   Boolean  @default(false)
  campo_filtro    String?
  tabla_origen    String?
  estado_registro Boolean  @default(true)
  fecha_registo   DateTime @default(now())
  fecha_edicion   DateTime @updatedAt

  items CatalogItem[]

  @@index([estado_registro])
}

model CatalogItem {
  id_catalog_item Int      @id @default(autoincrement())
  id_catalog      Int
  nombre          String   @db.VarChar(255)
  estado_registro Boolean  @default(true)
  fecha_registro  DateTime @default(now())
  fecha_edicion   DateTime @updatedAt

  catalog Catalog @relation(fields: [id_catalog], references: [id_catalogo], onDelete: Cascade)

  @@unique([id_catalog, nombre])
  @@index([id_catalog])
  @@index([estado_registro])
  @@index([nombre])
}

model Departamento {
  id_departamento Int      @id @default(autoincrement())
  nombre          String   @db.VarChar(100)
  estado_registro Boolean  @default(true)
  fecha_registro  DateTime @default(now())
  fecha_edicion   DateTime @updatedAt

  items      Comunidad[]
  respuestas FormularioRespuesta[]

  @@index([estado_registro])
}

model Comunidad {
  id_comunidad    Int          @id @default(autoincrement())
  id_departamento Int
  nombre          String       @db.VarChar(255)
  estado_registro Boolean      @default(true)
  fecha_registro  DateTime     @default(now())
  fecha_edicion   DateTime     @updatedAt
  departamento    Departamento @relation(fields: [id_departamento], references: [id_departamento], onDelete: Cascade)

  usuarios        UsuarioComunidad[]
  personas        Persona[]
  respuestas      FormularioRespuesta[]
  centrosAtencion CentroAtencion[]
  familias        Familia[]
  hitosEncuestas  HitosEncuesta[]
  centroNutremes  CentroNutreme[]

  @@unique([id_departamento, nombre])
  @@index([estado_registro])
  @@index([id_departamento, estado_registro])
}

model RangoHito {
  id_rango_hito   Int      @id @default(autoincrement())
  nombre          String   @db.VarChar(100)
  estado_registro Boolean  @default(true)
  fecha_registro  DateTime @default(now())
  fecha_edicion   DateTime @updatedAt

  items RangoHitoDetalle[]

  @@index([estado_registro])
}

model RangoHitoDetalle {
  id_rango_hito_detalle Int      @id @default(autoincrement())
  id_rango_hito         Int
  nombre                String   @db.VarChar(100)
  estado_registro       Boolean  @default(true)
  fecha_registro        DateTime @default(now())
  fecha_edicion         DateTime @updatedAt

  rangoHito RangoHito @relation(fields: [id_rango_hito], references: [id_rango_hito], onDelete: Cascade)

  @@unique([id_rango_hito, nombre])
  @@index([estado_registro])
  @@index([id_rango_hito, estado_registro])
}

//************** FIN CATALOGOS
// **********MODELOS DEL FORMULARIO

enum EstadoForm {
  BORRADOR
  PUBLICADO
}

model Formulario {
  id_formulario   Int        @id @default(autoincrement())
  uuid            String     @unique @default(uuid()) @db.VarChar(36)
  nombre          String     @db.VarChar(255)
  estado          EstadoForm @default(BORRADOR)
  version         Int        @default(1)
  estructura      Json?      @db.JsonB
  estado_registro Boolean    @default(true)

  // Creador
  usuario_registro Int
  creador          Usuario @relation("FormularioCreador", fields: [usuario_registro], references: [id_usuario])

  // Modificador
  usuario_modifico Int?
  modificador      Usuario? @relation("FormularioModificador", fields: [usuario_modifico], references: [id_usuario])

  fecha_registro DateTime @default(now())
  fecha_edicion  DateTime @updatedAt

  // Usuarios asignados
  usuariosAsignados FormularioUsuario[]
  respuestas        FormularioRespuesta[]
  hitosEncuestas    HitosEncuesta[]

  @@index([estado])
  @@index([estado_registro])
  @@index([estado, usuario_registro])
  @@index([usuario_registro, estado_registro])
  @@index([fecha_registro])
}

model FormularioUsuario {
  id_formulario Int
  id_usuario    Int

  formulario Formulario @relation(fields: [id_formulario], references: [id_formulario], onDelete: Cascade)
  usuario    Usuario    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@id([id_formulario, id_usuario])
  @@index([id_usuario])
}

model FormularioRespuesta {
  id_respuesta    Int      @id @default(autoincrement())
  id_formulario   Int
  id_usuario      Int? // usuario que llenó el formulario
  version_form    Int      @default(1) // versión del formulario al responder
  datos           Json     @db.JsonB // respuestas raw completas
  datos_limpios   Json?    @db.JsonB // solo campos visibles con valor
  id_comunidad    Int? // desnormalizado para reportes
  id_departamento Int? // desnormalizado para reportes
  estado_registro Boolean  @default(true)
  fecha_registro  DateTime @default(now())
  fecha_edicion   DateTime @updatedAt
  id_familia      Int?

  formulario      Formulario                   @relation(fields: [id_formulario], references: [id_formulario], onDelete: Cascade)
  usuario         Usuario?                     @relation(fields: [id_usuario], references: [id_usuario])
  comunidad       Comunidad?                   @relation(fields: [id_comunidad], references: [id_comunidad])
  departamento    Departamento?                @relation(fields: [id_departamento], references: [id_departamento])
  personas        FormularioRespuestaPersona[]
  familia         Familia?                     @relation(fields: [id_familia], references: [id_familia])
  carnetBimestres CarnetBimestre[]

  @@index([id_formulario])
  @@index([id_formulario, version_form])
  @@index([id_usuario])
  @@index([id_comunidad])
  @@index([id_departamento])
  @@index([fecha_registro])
  @@index([estado_registro])
  @@index([id_formulario, id_comunidad, fecha_registro])
  @@index([id_formulario, id_departamento, fecha_registro])
  @@index([id_familia])
}

//******** FIN MODELO DE FORMULARIOS

model Persona {
  id_persona             Int       @id @default(autoincrement())
  cui                    String    @unique @db.VarChar(20)
  nombres                String    @db.VarChar(150)
  apellidos              String    @db.VarChar(150)
  fecha_nacimiento       DateTime?
  sexo                   Int?
  direccion              String?   @db.VarChar(255)
  fecha_ingreso_programa DateTime?
  cui_madre              String?   @db.VarChar(20)
  tipo_persona           String?   @db.VarChar(20) // 'embarazada', 'nino'
  id_comunidad           Int?
  datos_extra            Json?     @db.JsonB // campos adicionales no estructurados
  registro_incompleto    Boolean   @default(false)
  qr_path                String?   @db.VarChar(500)
  estado_registro        Boolean   @default(true)
  fecha_registro         DateTime  @default(now())
  fecha_edicion          DateTime  @updatedAt
  codigo_temporal        String?   @unique @db.VarChar(20)

  comunidad        Comunidad?                   @relation(fields: [id_comunidad], references: [id_comunidad])
  respuestas       FormularioRespuestaPersona[]
  familiaComoMadre Familia[]                    @relation("FamiliaMadre")
  familias         FamiliaIntegrante[]
  carnetBimestres  CarnetBimestre[]
  hitosNinos       HitosNino[]

  @@index([cui])
  @@index([tipo_persona])
  @@index([id_comunidad])
  @@index([fecha_nacimiento])
  @@index([tipo_persona, id_comunidad])
  @@index([estado_registro])
  @@index([codigo_temporal])
  @@index([registro_incompleto])
}

model FormularioRespuestaPersona {
  id_respuesta Int
  id_persona   Int
  rol_en_form  String? @db.VarChar(50) // 'embarazada', 'nino'

  respuesta FormularioRespuesta @relation(fields: [id_respuesta], references: [id_respuesta], onDelete: Cascade)
  persona   Persona             @relation(fields: [id_persona], references: [id_persona])

  @@id([id_respuesta, id_persona])
  @@index([id_persona])
  @@index([rol_en_form])
}

model CatalogoImagenes {
  id_catalogo_imagen Int      @id @default(autoincrement())
  nombre             String   @db.VarChar(255)
  nombre_archivo     String   @db.VarChar(255)
  ruta               String   @db.VarChar(500)
  size               Float
  mime_type          String   @db.VarChar(100)
  estado_registro    Boolean  @default(true)
  fecha_registro     DateTime @default(now())
  fecha_edicion      DateTime @updatedAt

  @@index([estado_registro])
  @@index([nombre])
  @@index([fecha_registro])
}

model CentroAtencion {
  id_centro       Int      @id @default(autoincrement())
  id_comunidad    Int
  nombre          String   @db.VarChar(255)
  estado_registro Boolean  @default(true)
  fecha_registro  DateTime @default(now())
  fecha_edicion   DateTime @updatedAt

  comunidad Comunidad @relation(fields: [id_comunidad], references: [id_comunidad], onDelete: Cascade)

  @@unique([id_comunidad, nombre])
  @@index([id_comunidad, estado_registro])
  @@index([estado_registro])
}

model Familia {
  id_familia      Int      @id @default(autoincrement())
  codigo          String   @unique @db.VarChar(20)
  id_comunidad    Int
  id_madre        Int
  qr_path         String?  @db.VarChar(500)
  estado_registro Boolean  @default(true)
  fecha_registro  DateTime @default(now())
  fecha_edicion   DateTime @updatedAt

  comunidad   Comunidad             @relation(fields: [id_comunidad], references: [id_comunidad])
  madre       Persona               @relation("FamiliaMadre", fields: [id_madre], references: [id_persona])
  integrantes FamiliaIntegrante[]
  respuestas  FormularioRespuesta[]

  @@index([id_comunidad])
  @@index([id_madre])
  @@index([codigo])
  @@index([estado_registro])
  @@index([id_comunidad, estado_registro])
}

model FamiliaIntegrante {
  id_familia      Int
  id_persona      Int
  rol             RolFamilia
  estado_registro Boolean    @default(true)
  fecha_registro  DateTime   @default(now())
  fecha_edicion   DateTime   @updatedAt

  familia Familia @relation(fields: [id_familia], references: [id_familia], onDelete: Cascade)
  persona Persona @relation(fields: [id_persona], references: [id_persona])

  @@id([id_familia, id_persona])
  @@index([id_familia])
  @@index([id_persona])
  @@index([rol])
}

enum RolFamilia {
  MADRE
  PADRE
  NINO
  ENCARGADO
}

model CarnetBimestre {
  id_carnet_bimestre Int      @id @default(autoincrement())
  id_respuesta       Int
  id_persona         Int
  mes                Int // ID del catálogo: 431-442
  bimestre           Int // 1-6 calculado automáticamente
  huellas            Json     @db.JsonB // [{fecha, sesion}, ...]
  estado_registro    Boolean  @default(true)
  fecha_registro     DateTime @default(now())
  fecha_edicion      DateTime @updatedAt

  respuesta FormularioRespuesta @relation(fields: [id_respuesta], references: [id_respuesta], onDelete: Cascade)
  persona   Persona             @relation(fields: [id_persona], references: [id_persona])

  @@unique([id_respuesta, mes])
  @@index([id_respuesta])
  @@index([id_persona])
  @@index([bimestre])
  @@index([mes])
  @@index([estado_registro])
}

// ══════════════════════════════════════════
// HITOS DE DESARROLLO
// ══════════════════════════════════════════

model HitosEncuesta {
  id_encuesta     Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid()) @db.VarChar(60)
  id_formulario   Int
  id_comunidad    Int
  id_usuario      Int?
  cantidad_ninos  Int      @default(0)
  estado          String   @default("completa") @db.VarChar(30)
  estado_registro Boolean  @default(true)
  fecha_registro  DateTime @default(now())
  fecha_edicion   DateTime @updatedAt

  formulario Formulario  @relation(fields: [id_formulario], references: [id_formulario])
  comunidad  Comunidad   @relation(fields: [id_comunidad], references: [id_comunidad])
  usuario    Usuario?    @relation(fields: [id_usuario], references: [id_usuario])
  ninos      HitosNino[]

  @@index([id_formulario])
  @@index([id_comunidad])
  @@index([id_usuario])
  @@index([estado_registro])
  @@index([fecha_registro])
  @@index([id_formulario, id_comunidad])
  @@index([id_formulario, id_comunidad, fecha_registro])
  @@index([id_comunidad, fecha_registro])
  @@index([id_usuario, estado_registro])
  @@index([estado, estado_registro])
}

model HitosNino {
  id_nino              Int      @id @default(autoincrement())
  uuid                 String   @unique @default(uuid()) @db.VarChar(60)
  id_encuesta          Int
  id_persona           Int?
  indice               Int
  nombres              String   @db.VarChar(150)
  apellidos            String   @db.VarChar(150)
  tiene_consentimiento Boolean  @default(true)
  tabla_element_id     String?  @db.VarChar(100)
  responses            Json?    @db.JsonB
  estado_registro      Boolean  @default(true)
  fecha_registro       DateTime @default(now())
  fecha_edicion        DateTime @updatedAt

  encuesta HitosEncuesta         @relation(fields: [id_encuesta], references: [id_encuesta], onDelete: Cascade)
  persona  Persona?              @relation(fields: [id_persona], references: [id_persona])
  tablas   HitosTablaRespuesta[]

  @@index([id_encuesta])
  @@index([id_persona])
  @@index([estado_registro])
  @@index([id_encuesta, indice])
  @@index([tiene_consentimiento])
  @@index([id_encuesta, tiene_consentimiento])
  @@index([id_encuesta, estado_registro])
}

model HitosTablaRespuesta {
  id_tabla_resp    Int      @id @default(autoincrement())
  id_nino          Int
  table_element_id String   @db.VarChar(100)
  row_id           String   @db.VarChar(50)
  group_id         String   @db.VarChar(100)
  col_id           String   @db.VarChar(50)
  estado_registro  Boolean  @default(true)
  fecha_registro   DateTime @default(now())
  fecha_edicion    DateTime @updatedAt

  nino HitosNino @relation(fields: [id_nino], references: [id_nino], onDelete: Cascade)

  @@unique([id_nino, table_element_id, row_id, group_id])
  @@index([id_nino])
  @@index([table_element_id])
  @@index([estado_registro])
  @@index([id_nino, table_element_id])
  @@index([row_id])
  @@index([group_id])
  @@index([col_id])
}

model CentroNutreme {
  id_centro_nutreme Int      @id @default(autoincrement())
  uuid              String   @unique @default(uuid()) @db.VarChar(36)
  codigo            String   @unique @db.VarChar(50)
  nombre            String   @db.VarChar(255)
  id_comunidad      Int
  id_usuario        Int? //personal a carg
  // coordenadas       String?  @db.VarChar(100) //lat, lng
  latitud           Float?
  longitud          Float?
  qr_path           String?  @db.VarChar(500)
  estado_registro   Boolean  @default(true)
  fecha_registro    DateTime @default(now())
  fecha_edicion     DateTime @updatedAt

  comunidad Comunidad @relation(fields: [id_comunidad], references: [id_comunidad])
  usuario   Usuario?  @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_comunidad])
  @@index([id_usuario])
  @@index([estado_registro])
  @@index([codigo])
}


model SyncStaging{
  id      Int @id @default(autoincrement())
  tipo    String  @db.VarChar(50) //boletas, hitos o centros nutreme
  payload Json
  estado String @default("pendiente") @db.VarChar(20) //Pendiente, procesado, completado, o error
  intentos Int @default(0)
  error_mensaje String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  processed_at DateTime?

  @@index([estado])
  @@index([created_at])
}